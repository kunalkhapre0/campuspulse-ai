# ==============================================================================
# CampusPulse AI — Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER put AWS IAM credentials, Secret Access Keys, or private tokens in VITE_* vars.

# Base URL of your deployed Amazon API Gateway HTTP API (no trailing slash).
# Leave empty to run the application in clearly labeled Demo Mode.
VITE_API_BASE_URL=""

# Public AWS region identifier (informational for Cognito / display)
VITE_AWS_REGION="us-east-1"

# Optional Amazon Cognito Hosted UI / User Pool configuration for organizer auth
VITE_COGNITO_USER_POOL_ID=""
VITE_COGNITO_CLIENT_ID=""
VITE_COGNITO_DOMAIN=""

# Application display title
VITE_APP_NAME="CampusPulse AI"
